# Browser authentication. Required together in production.
# With neither key, demo-owner access is available ONLY outside production.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# Assign workspaceId and role using Clerk's backend-managed public metadata.
# Allowed roles: viewer, engineer, admin, owner.
# See docs/authentication.md before enabling production traffic.

# Shared secret used ONLY for the PlatformPilot ingestion endpoint.
PLATFORM_PILOT_INGEST_TOKEN=replace-with-a-long-random-token
# Required for ingestion outside the unconfigured local demo.
# PLATFORM_PILOT_WORKSPACE_ID=workspace-your-team
